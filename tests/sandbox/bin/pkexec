#!/bin/sh
# SANDBOX-MARKER
# FAKE_PKEXEC_HANG stages the prompt nobody answers. Until pkexec becomes
# root it is an ordinary child of the applet's, and terminating it is what
# dismisses the dialog -- so this must be a process that dies on SIGTERM and
# says nothing. `exec sleep` rather than a loop: the pid the applet holds is
# then the pid that has to die, and no orphan outlives the scenario.
#
# Nothing is printed on the way in. The applet's `helper_spoke` turns on for
# a decodable protocol line only, so chatter here would not set it -- but a
# stand-in that talks while pretending to be a dialog nobody answered is
# staging the wrong thing.
if [ -n "$FAKE_PKEXEC_HANG" ]; then
  # The variable is a path, and the pid goes in it. The scenario used to find
  # this process with `pgrep -f "^sleep 3600$"`, and enter.sh gives the
  # sandbox a user and mount namespace but no PID namespace -- so that search
  # saw the whole host, took the lowest match, and failed against an unrelated
  # sleep somebody had left running. Which is exactly what happened.
  echo $$ > "$FAKE_PKEXEC_HANG"
  exec sleep 3600
fi
exec "$@"
